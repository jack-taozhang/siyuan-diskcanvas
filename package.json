{
  "name": "siyuan-diskcanvas-next",
  "version": "0.1.0",
  "type": "module",
  "description": "SiYuan canvas workspace: NebulaDisk files + notes on an infinite canvas",
  "author": "zhangtao",
  "license": "MIT",
  "homepage": "https://github.com/jack-taozhang/siyuan-diskcanvas-next",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check:refs": "node tools/check-broken-refs.mjs",
    "check:host": "node tools/check-host-contract.mjs",
    "check:editor-refs": "node tools/audit-editor-refs.mjs",
    "check:nebula-open": "node tools/check-nebula-open-contract.mjs",
    "check:asset-insert": "node tools/check-asset-insert-contract.mjs",
    "check:embed-style": "node tools/check-embed-style-parity.mjs",
    "check:embed-slash": "node tools/check-embed-interactive-slash.mjs",
    "check:load": "node .verify/load.cjs",
    "verify:e2e": "vite build --config verify.vite.config.ts && node verify-run.cjs",
    "verify": "npm run check:refs && npm run check:host && npm run check:editor-refs && npm run check:nebula-open && npm run check:asset-insert && npm run check:embed-style && npm run check:embed-slash && npm run build && npm run check:load && npm run verify:e2e",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "marked": "^16.4.2",
    "vue": "^3.3.8"
  },
  "devDependencies": {
    "@types/node": "^20.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "fast-glob": "^3.2.12",
    "glob": "^11.0.1",
    "jsdom": "^29.0.2",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.62.1",
    "siyuan": "1.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^0.15.0",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^4.1.3"
  }
}
